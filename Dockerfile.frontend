# Frontend-only Dockerfile
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy nginx configuration
COPY .docker/nginx/nginx-frontend.conf /etc/nginx/nginx.conf

# Copy frontend files preserving directory structure
COPY src/ /usr/share/nginx/html/src/
COPY index.html /usr/share/nginx/html/
COPY favicon.png manifest.webmanifest sw.js /usr/share/nginx/html/
COPY icons/ /usr/share/nginx/html/icons/

# Build id for the app's "Update ready" bar (pwa.js). Docker reuses this layer
# while the files above are unchanged, so it only changes when the frontend does.
RUN echo "{\"build\":\"$(date -u +%Y%m%d%H%M%S)\"}" > /usr/share/nginx/html/version.json

# Set permissions
RUN chmod -R 755 /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
