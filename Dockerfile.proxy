# Proxy-only Dockerfile
FROM node:18-alpine

# Install curl for healthcheck
RUN apk add --no-cache curl

WORKDIR /app

# Copy package files
COPY proxy/package*.json ./

# Install dependencies
RUN npm install --only=production

# Copy proxy source
COPY proxy/server.js ./
COPY proxy/runs/ ./runs/

# The browser's prompt code, which the proxy runs too for server-run
# generations (proxy/runs/prompt-host.js). Listed one by one on purpose: a
# change to any other front-end file then leaves this image, and the running
# proxy with its in-flight jobs, alone. Keep in step with SHARED_SCRIPTS.
COPY src/scripts/content-context.js src/scripts/name-bank-data.js src/scripts/name-bank.js \
     src/scripts/api-character.js src/scripts/api-lorebook.js src/scripts/character-search.js \
     src/scripts/character-generator.js \
     src/scripts/image-model-caps.js src/scripts/prompt-look.js src/scripts/h3-edit-caption-prompt.js \
     src/scripts/api-image.js \
     ./src/scripts/

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Change ownership
RUN chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE 2426

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:2426/health || exit 1

# Start the proxy server
CMD ["node", "server.js"]
